{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop fixture-orphan", "statusMessage": "[bridge:fixture-orphan]" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop sentinel-stop", "timeout": 30, "statusMessage": "[bridge:sentinel-stop]" }
        ]
      }
    ]
  }
}
