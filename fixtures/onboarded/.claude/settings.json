{
  "skillOverrides": {
    "fixture-bom-with-a-very-long-directory-name-exceeding-codexs-limit": "off",
    "fixture-claude-flavored": "off",
    "fixture-codex-only": "off",
    "fixture-drifted": "off",
    "fixture-portable": "off",
    "fixture-undiscoverable": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop sandbox-guard", "timeout": 5, "statusMessage": "[bridge:sandbox-guard]" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop user-owned" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop sentinel-stop", "timeout": 30, "statusMessage": "[bridge:sentinel-stop]" }
        ]
      }
    ]
  }
}
