{
  "skillOverrides": {
    "fixture-bom-with-a-very-long-directory-name-exceeding-codexs-limit": "off",
    "fixture-claude-flavored": "off",
    "fixture-codex-only": "off",
    "fixture-drifted": "off",
    "fixture-portable": "off",
    "fixture-undiscoverable": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "git rev-parse --is-inside-work-tree", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "echo user-owned-hook" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "git status --short", "timeout": 30 }
        ]
      }
    ]
  }
}
