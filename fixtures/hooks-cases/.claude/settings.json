{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop post-write"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop compact-legacy",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop guard",
            "timeout": 5,
            "retries": 2
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop session-note",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop subagent-note",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bridge-fixture-noop subagent-extra",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
