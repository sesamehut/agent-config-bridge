{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop session-note",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": {
      "hooks": [
        {
          "type": "command",
          "command": "bridge-fixture-noop wrap-up",
          "timeout": 30
        }
      ]
    }
  }
}
