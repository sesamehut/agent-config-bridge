{
  "description": "Project hooks reviewed by the team on 2026-08-30.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop fmt-on-save-hand",
            "timeout": 10,
            "statusMessage": "[bridge:fmt-on-save]"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop team-banner",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
