{
  "permissions": {
    "allow": ["Read(//src/**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop fmt-on-save",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop fmt-on-save",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
