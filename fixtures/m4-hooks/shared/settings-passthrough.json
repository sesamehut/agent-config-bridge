{
  "permissions": {
    "allow": ["Read(//src/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "bridge-fixture-noop shell-preview",
            "timeout": 20,
            "statusMessage": "[bridge:shell-preview]",
            "if": "tool_input.command != ''"
          }
        ]
      }
    ]
  }
}
