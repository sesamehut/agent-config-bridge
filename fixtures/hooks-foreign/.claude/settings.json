{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop write-observe", "timeout": 10, "statusMessage": "[bridge:semantics-async]", "async": true }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop shell-observe", "timeout": 5, "statusMessage": "[bridge:foreign-mcp]" },
          { "type": "mcp_tool", "server": "fixture-inert", "tool": "record_note", "input": { "note": "${tool_input.command}" } }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop session-note", "timeout": 5, "statusMessage": "[bridge:session-note]" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bridge-fixture-noop prompt-note", "statusMessage": "[bridge:prompt-note]", "if": "false" }
        ]
      }
    ]
  }
}
