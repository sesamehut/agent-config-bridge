{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "WebSearch",
      "Bash",
      "PowerShell"
    ],
    "deny": [],
    "ask": [
      "Bash(*git push --force*)",
      "Bash(*git push -f*)",
      "Bash(*git reset --hard*)",
      "Bash(*git clean -f*)",
      "Bash(*git branch -D *)",
      "Bash(*rm -rf /*)",
      "Bash(*rm -rf ~*)",
      "PowerShell(*git push --force*)",
      "PowerShell(*git push -f*)",
      "PowerShell(*git reset --hard*)",
      "PowerShell(*git clean -f*)",
      "PowerShell(*git branch -D *)",
      "PowerShell(*Remove-Item*-Recurse*-Force*)",
      "PowerShell(*Remove-Item*-Force*-Recurse*)",
      "PowerShell(*rd /s /q*)",
      "PowerShell(*rmdir /s /q*)",
      "PowerShell(*Stop-Process*-Force*)",
      "PowerShell(*Set-ExecutionPolicy*)"
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "plansDirectory": ".claude/plans",
  "claudeMdExcludes": ["**/fixtures/**"],
  "skillOverrides": {
    "fixture-adopt": "off",
    "fixture-allowed-tools": "off",
    "fixture-at-path-static": "off",
    "fixture-auto-projection": "off",
    "fixture-auto-source": "off",
    "fixture-batch-conflict": "off",
    "fixture-batch-other": "off",
    "fixture-bom-with-a-very-long-directory-name-exceeding-codexs-limit": "off",
    "fixture-claude-flavored": "off",
    "fixture-codex-only": "off",
    "fixture-conflict": "off",
    "fixture-consumer": "off",
    "fixture-covenant-bootstrap": "off",
    "fixture-covenant-partial": "off",
    "fixture-create": "off",
    "fixture-dag-ambiguous": "off",
    "fixture-drifted": "off",
    "fixture-dynamic-content": "off",
    "fixture-extra-files": "off",
    "fixture-legacy-carry": "off",
    "fixture-legacy-release": "off",
    "fixture-legacy-repair": "off",
    "fixture-manual-copy": "off",
    "fixture-no-skill": "off",
    "fixture-portable": "off",
    "fixture-prerequisite": "off",
    "fixture-reproject": "off",
    "fixture-source-link": "off",
    "fixture-target-link": "off",
    "fixture-untracked": "off",
    "fixture-undiscoverable": "off",
    "fixture-write-first": "off",
    "fixture-write-second": "off"
  }
}
